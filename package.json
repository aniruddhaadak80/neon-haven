{
  "name": "neon-haven",
  "version": "1.0.0",
  "private": true,
  "description": "NEON HAVEN — an open-world, GTA-style browser game built with Next.js and Three.js. Procedurally generated city, drivable vehicles, pedestrians, wanted level, and missions. All third-party art is Kenney (CC0).",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "assets:fetch": "powershell -ExecutionPolicy Bypass -File scripts/fetch-assets.ps1",
    "assets:inspect": "node scripts/inspect-glb.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "next": "15.5.27",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "three": "0.181.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.14",
    "@types/node": "22.18.8",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@types/three": "0.181.0",
    "eslint": "9.37.0",
    "eslint-config-next": "15.5.27",
    "tailwindcss": "4.1.14",
    "typescript": "5.9.3"
  },
  "allowScripts": {
    "@tailwindcss/oxide@4.1.14": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true
  }
}
