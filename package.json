{
  "name": "neon-haven",
  "version": "1.0.0",
  "private": true,
  "description": "NEON HAVEN \u2014 an open-world, GTA-style browser game built with Next.js and Three.js. Procedurally generated city, drivable vehicles, pedestrians, wanted level, and missions. All third-party art is Kenney (CC0).",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "assets:fetch": "powershell -ExecutionPolicy Bypass -File scripts/fetch-assets.ps1",
    "assets:prepare": "node scripts/prepare-models.mjs",
    "assets:inspect": "node scripts/inspect-glb.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "next": "15.5.29",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "three": "0.181.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/postcss": "4.1.14",
    "@types/node": "22.18.8",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@types/three": "0.181.0",
    "eslint": "9.37.0",
    "eslint-config-next": "15.5.27",
    "tailwindcss": "4.1.14",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  },
  "allowScripts": {
    "@tailwindcss/oxide@4.1.14": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true
  },
  "overrides": {
    "sharp": "0.35.5",
    "postcss": "8.5.33",
    "tar": "7.5.21",
    "undici": "8.12.2",
    "js-yaml": "4.3.2",
    "smol-toml": "1.7.1",
    "follow-redirects": "1.16.2",
    "axios": "1.20.0",
    "fast-uri": "4.1.4",
    "ip-address": "10.3.1",
    "@azure/msal-node": "7.1.0",
    "@opentelemetry/propagator-jaeger": "2.9.0",
    "markdown-it": "14.3.3",
    "source-map-js": "1.2.2"
  }
}
